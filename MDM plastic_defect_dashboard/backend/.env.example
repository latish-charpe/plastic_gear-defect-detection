# ==============================================================================
# GearDefect AI Backend Environment Configuration (Render / Local Development)
# ==============================================================================

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Set to your deployed Vercel domain (e.g. https://geardefect-ai.vercel.app)
# Comma-separated list for multiple origins. Localhost is automatically supported in dev.
FRONTEND_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app

# ── Sarvam AI Indic Translation ───────────────────────────────────────────────
# Obtain your key from https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Server & Model Settings (Render dynamically sets $PORT) ────────────────────
PORT=8000
HOST=0.0.0.0
# Optional override for YOLO model file path if stored in custom directory
# YOLO_MODEL_PATH=models/yolo11m_targeted_best.pt
