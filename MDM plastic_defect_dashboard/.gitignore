# ==============================================================================
# Git Ignore Configuration for GearDefect AI
# ==============================================================================

# ── Secrets and Environment Variables ─────────────────────────────────────────
# Never commit credentials, API keys, or private .env files
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
!*.env.example
!backend/.env.example
!frontend/.env.example

# ── Python / Virtual Environments ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Node.js / Frontend ────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Temporary Inspection Data & Generated Outputs ─────────────────────────────
# Exclude dynamic inspection uploads, annotated outputs, and synthesized audio caches
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/audio_cache/*
!backend/audio_cache/.gitkeep
uploads/*
outputs/*
audio_cache/*

# ── System and IDE Artifacts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── AI Model Weights (Explicitly Whitelisted) ──────────────────────────────────
# yolo11m_targeted_best.pt is ~40.5 MB and fully supported by GitHub (< 100 MB limit)
!models/
!models/*.pt
!backend/models/
!backend/models/*.pt
